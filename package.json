{
  "name": "saudi-wind",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:functions": "wrangler pages functions build functions --outdir .wrangler/functions-build --project-directory . --build-output-directory dist --minify",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "playwright test",
    "test:pipeline": "uv run pytest",
    "check:pipeline": "uv run ruff format --check pipeline && uv run ruff check pipeline && uv run pytest",
    "typecheck": "tsc -b",
    "typecheck:functions": "wrangler types --check --path ./functions/types.d.ts && tsc -p functions/tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run format:check && bun run typecheck && bun run typecheck:functions && bun run test && bun run build && bun run build:functions"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "d3-geo": "3.1.1",
    "earcut": "3.0.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260728.1",
    "@playwright/test": "1.62.0",
    "@types/d3-geo": "3.1.0",
    "@types/earcut": "3.0.0",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "wrangler": "4.115.0"
  }
}
