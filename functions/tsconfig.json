{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "types": ["./types.d.ts"],
    "strict": true,
    "noEmit": true,
    "noUncheckedIndexedAccess": false,
    "skipLibCheck": true
  },
  "include": ["./**/*.ts"]
}
